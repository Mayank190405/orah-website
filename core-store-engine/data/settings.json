{
  "brand": {
    "type": "image",
    "logo_url": "assets/images/logo.png",
    "text": "ORAH HOUSE"
  },
  "header": {
    "background_color": "transparent",
    "text_color": "#681418",
    "layout": "logo_left_menu_right"
  },
  "menu": [
    { "label": "Menu", "url": "#menu", "order": 1 },
    { "label": "Our Story", "url": "#story", "order": 2 },
    { "label": "Experiences", "url": "#experiences", "order": 3 }
  ],
  "hero": {
    "subtitle": "",
    "title": "EAT.\nSIP.\nGATHER.",
    "description": "Food that nourishes.\nMoments that matter.",
    "button_text": "EXPLORE OUR MENU →",
    "footer_note": "A PREMIUM CAFÉ EXPERIENCE\nIN NASHIK",
    "image_url": ""
  },
  "theme": {
    "primary_accent": "#681418",
    "secondary_accent": "#c99a68",
    "background_color": "#FBF6EE",
    "card_background": "#ffffff",
    "font_family_heading": "'Dream Avenue', Georgia, serif",
    "font_family_body": "'Manrope', sans-serif",
    "font_family_subheading": "'Cormorant Garamond', 'Playfair Display', Georgia, serif",
